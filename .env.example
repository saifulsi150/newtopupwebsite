# Root deployment configuration
# Copy this file to .env on the VPS, then run ./deploy.sh

APP_NAME=tast.topup
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
NUXT_PUBLIC_SITE_NAME=tast.topup

# Public ports exposed by docker compose
BACKEND_PORT=8000
USER_FRONTEND_PORT=3000
ADMIN_FRONTEND_PORT=3001
MYSQL_PUBLIC_PORT=3306
REDIS_PUBLIC_PORT=6379

# Domains used by the Nuxt apps
APP_DOMAIN=127.0.0.1
ADMIN_DOMAIN=127.0.0.1
NUXT_APP_BASE_URL=/
NUXT_PUBLIC_SUPPORT_URL=https://t.me/admimapp

# MySQL / Redis runtime settings
MYSQL_DATABASE=topup_db_tast_ffuid
MYSQL_USER=topup_user_1091
MYSQL_PASSWORD=change_me_now
MYSQL_ROOT_PASSWORD=change_root_password_now
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Admin frontend secret and deployment bootstrap user
ADMIN_SECRET=change_this_secret_123
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_admin_password_now

# System update secret — must match X-Update-Token header sent by admin panel
SYSTEM_UPDATE_SECRET=change_this_update_secret_now

# Deployment SQL files
# Use a sanitized full schema dump here for a complete website installation.
DEPLOY_SCHEMA_FILE=database-backup/schema.sql
DEPLOY_SAMPLE_SQL_FILE=apps/user-frontend/docker/mysql/init.sql

# Optional third-party credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
NUXT_PUBLIC_GOOGLE_REDIRECT_URI=/api/auth/google/callback
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=
