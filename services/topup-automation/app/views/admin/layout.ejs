<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=0.8,maximum-scale=5,user-scalable=no"><title><%= title %> | Auto Top Up Panel</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/admin.css"> <%- style %> <style>body{min-height:100vh;overflow-x:hidden;padding-top:0;font-family:Rajdhani,sans-serif}.app-navbar{background:linear-gradient(135deg,#012 0,#034 50%,#023 100%);box-shadow:0 2px 20px rgba(0,255,127,.2),0 4px 40px rgba(0,0,0,.3);padding:.6rem 1rem;border-bottom:1px solid rgba(0,255,127,.3);position:sticky!important;top:0!important;z-index:1050;overflow:hidden}.app-navbar::before{content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;background:linear-gradient(90deg,transparent,rgba(0,255,127,.1),transparent);animation:matrix-scan 4s infinite}@keyframes matrix-scan{0%{left:-100%}100%{left:100%}}.app-logo{font-weight:800;letter-spacing:1.5px;font-size:1.4rem;display:flex;align-items:center;gap:.8rem;transition:transform .18s cubic-bezier(.4,2,.6,1);text-decoration:none;position:relative;z-index:10}.app-logo:hover{transform:scale(1.06) translateY(-2px);text-shadow:0 4px 16px #0d6efd44,0 2px 0 #fff}.app-logo i{margin-right:8px;filter:drop-shadow(0 0 2px rgba(255, 255, 255, .3))}.nav-link-custom{color:rgba(255,255,255,.9)!important;padding:.5rem .8rem!important;border-radius:6px;transition:all .2s ease}.nav-link-custom:hover{background-color:rgba(255,255,255,.1);color:#fff!important}.btn-outline-warning{border-color:rgba(255,193,7,.8);color:rgba(255,193,7,.9)}.btn-outline-warning:hover{background-color:rgba(255,193,7,.1);border-color:#ffc107;color:#ffc107}.btn-outline-light{border-color:rgba(255,255,255,.8)}.btn-outline-light:hover{background-color:rgba(255,255,255,.1);border-color:#fff}#restartModal .modal-content{border-radius:1rem;overflow:hidden}#restartModal .modal-header{padding:1.25rem 1.5rem}#restartModal .modal-body{padding:1.5rem}#restartModal .modal-footer{padding:1.25rem 1.5rem}#restartModal .bi-arrow-clockwise{animation:rotate-icon 2s linear infinite}@keyframes rotate-icon{from{transform:rotate(0)}to{transform:rotate(360deg)}}#restartModal .btn{min-width:120px}.user-avatar{width:32px;height:32px;background-color:rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-right:8px}.sidebar-toggle-btn{background-color:rgba(255,255,255,.15);border:none;border-radius:4px;color:#fff;padding:.4rem .6rem;margin-right:.8rem}.sidebar-toggle-btn:hover{background-color:rgba(255,255,255,.25)}.dropdown-menu{border-radius:.5rem;box-shadow:0 5px 15px rgba(0,0,0,.1);border:1px solid rgba(0,0,0,.05);padding:.5rem 0}.dropdown-item{padding:.5rem 1.2rem;font-size:.9rem}.dropdown-item:active{background-color:#0d6efd}@media (max-width:575.98px){.app-logo{font-size:1rem;gap:.3rem}.coding-icon{width:22px;height:22px;margin-right:6px}.logo-text{font-size:1rem;letter-spacing:1px}.btn-sm{padding:.35rem .5rem;font-size:.8rem}.btn-sm i{font-size:.9rem}}@media (max-width:400px){.app-logo{font-size:1rem;gap:.4rem}.coding-icon{width:18px;height:18px;margin-right:6px}.logo-text{font-size:.9rem;letter-spacing:.5px}}@media (max-width:350px){.app-logo .logo-text{display:none}.coding-icon{width:24px;height:24px}.btn-sm{padding:.25rem .4rem}}.sidebar{position:fixed;top:56px;left:0;bottom:0;z-index:100;padding:0;box-shadow:0 2px 5px 0 rgba(0,0,0,.05);width:220px;transition:all .3s}@media (max-width:767.98px){.sidebar{margin-left:-220px}.sidebar.show{margin-left:0}}.sidebar .nav-link{padding:1rem;font-size:.95rem;border-left:3px solid transparent}.sidebar .nav-link.active{background-color:rgba(13,110,253,.1);border-left-color:#0d6efd}.sidebar .nav-link:hover{background-color:rgba(13,110,253,.05)}.sidebar .nav-link.text-danger:hover{background-color:rgba(220,53,69,.1);color:#dc3545!important}.content-wrapper{transition:all .3s}@media (min-width:768px){.content-wrapper{margin-left:220px}}@media (max-width:767.98px){.content-wrapper{margin-left:0}}.content{padding:1.5rem;margin-top:1px}.coding-icon{width:32px;height:32px;margin-right:12px;filter:drop-shadow(0 0 8px rgba(0, 255, 127, .6));animation:matrix-glow 2s infinite ease-in-out;transition:all .3s ease}.app-logo:hover .coding-icon{filter:drop-shadow(0 0 15px rgba(0, 255, 127, .9)) drop-shadow(0 0 25px rgba(0, 255, 255, .5));transform:scale(1.1) rotateY(10deg)}.coding-icon .cursor-blink{animation:cursor-blink 1.2s infinite}.coding-icon .code-line{animation:code-appear 3s infinite;stroke-dasharray:6;stroke-dashoffset:6}.coding-icon .code-line-2{animation:code-appear 3s infinite .5s;stroke-dasharray:8;stroke-dashoffset:8}.coding-icon .terminal-dot{animation:terminal-pulse 1.5s infinite}.logo-text{background:linear-gradient(45deg,#00ff7f,#0ff,#fff,#00ff7f);background-size:300% 300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:hacker-text-glow 3s infinite;font-family:monospace;font-weight:700;letter-spacing:2px;text-shadow:0 0 10px rgba(0,255,127,.5);font-size:1.4rem}@keyframes matrix-glow{0%,100%{filter:drop-shadow(0 0 8px rgba(0, 255, 127, .6));transform:scale(1)}50%{filter:drop-shadow(0 0 20px rgba(0, 255, 127, .9)) drop-shadow(0 0 30px rgba(0, 255, 255, .6));transform:scale(1.02)}}@keyframes cursor-blink{0%,50%{opacity:1}100%,51%{opacity:0}}@keyframes code-appear{0%{stroke-dashoffset:6;opacity:.3}50%{stroke-dashoffset:0;opacity:1}100%{stroke-dashoffset:-6;opacity:.3}}@keyframes terminal-pulse{0%,100%{opacity:.7;transform:scale(1)}50%{opacity:1;transform:scale(1.2);filter:drop-shadow(0 0 5px currentColor)}}@keyframes hacker-text-glow{0%{background-position:0 50%;text-shadow:0 0 5px rgba(0,255,127,.5)}50%{background-position:100% 50%;text-shadow:0 0 15px rgba(0,255,127,.8),0 0 25px rgba(0,255,255,.5)}100%{background-position:0 50%;text-shadow:0 0 5px rgba(0,255,127,.5)}}</style></head><body><nav class="navbar navbar-expand-lg app-navbar sticky-top"><div class="container-fluid"><button class="sidebar-toggle-btn d-md-none" type="button" id="sidebarToggle"><i class="bi bi-list"></i></button> <a class="navbar-brand app-logo text-white" href="/admin/dashboard"><svg class="coding-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="4" width="28" height="20" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M2 8h28" stroke="currentColor" stroke-width="1.5"/><circle cx="6" cy="6" r="1" fill="#ff5f57"/><circle cx="10" cy="6" r="1" fill="#ffbd2e"/><circle cx="14" cy="6" r="1" fill="#28ca42"/><path d="M8 12l3 2-3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="cursor-blink"/><path d="M14 16h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="code-line"/><path d="M6 20h8" stroke="currentColor" stroke-width="1" stroke-linecap="round" class="code-line-2"/><circle cx="26" cy="28" r="2" fill="currentColor" class="terminal-dot"/></svg> <span class="logo-text">Auto Top Up Panel</span></a><div class="d-flex align-items-center gap-2"><button class="btn btn-outline-warning btn-sm" id="restartBtn" title="Restart System"><i class="bi bi-arrow-clockwise"></i> <span class="d-none d-sm-inline ms-1">Restart</span></button> <a class="btn btn-outline-light btn-sm d-none d-md-inline-flex" href="/auth/logout" title="Logout"><i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline ms-1">Logout</span></a></div></div></nav><div class="modal fade" id="restartModal" tabindex="-1" aria-labelledby="restartModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow-lg"><div class="modal-header bg-warning text-dark border-0"><h5 class="modal-title d-flex align-items-center" id="restartModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i> System Restart Confirmation</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="text-center py-3"><div class="mb-3"><i class="bi bi-arrow-clockwise text-warning" style="font-size:3rem"></i></div><h6 class="mb-3">Are you sure you want to restart the system?</h6><p class="text-muted mb-0">This will temporarily interrupt all operations and active sessions. You will need to log in again after the restart.</p></div></div><div class="modal-footer border-0 justify-content-center"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-circle me-1"></i>Cancel</button> <button type="button" class="btn btn-warning" id="confirmRestartBtn"><i class="bi bi-arrow-clockwise me-1"></i>Yes, Restart Now</button></div></div></div></div><div class="sidebar" id="sidebarMenu"><div class="position-sticky pt-3"><ul class="nav flex-column"><li class="nav-item"><a class="nav-link <%= title === 'Admin Dashboard' ? 'active' : '' %>" href="/admin/dashboard"><span class="icon-square"><i class="bi bi-speedometer2"></i></span> Dashboard</a></li><li class="nav-item"><a class="nav-link <%= title === 'Redeem Codes Management' ? 'active' : '' %>" href="/admin/codes"><span class="icon-square"><i class="bi bi-upc"></i></span> Redeem Codes</a></li><li class="nav-item"><a class="nav-link <%= title === 'Orders Management' ? 'active' : '' %>" href="/admin/orders"><span class="icon-square"><i class="bi bi-cart3"></i></span> Orders</a></li><li class="nav-item"><a class="nav-link <%= title === 'Reseller Orders' ? 'active' : '' %>" href="/admin/reseller-orders"><span class="icon-square"><i class="bi bi-shop"></i></span> Reseller Orders</a></li><li class="nav-item"><a class="nav-link <%= title === 'System Logs' ? 'active' : '' %>" href="/admin/logs"><span class="icon-square"><i class="bi bi-list-check"></i></span> Logs</a></li><li class="nav-item"><a class="nav-link <%= title === 'Statistics' ? 'active' : '' %>" href="/admin/statistics"><span class="icon-square"><i class="bi bi-graph-up"></i></span> Statistics</a></li><li class="nav-item"><a class="nav-link <%= title === 'System Settings' ? 'active' : '' %>" href="/admin/settings"><span class="icon-square"><i class="bi bi-gear"></i></span> Settings</a></li><li class="nav-item"><a class="nav-link <%= title === 'Website Integration Settings' ? 'active' : '' %>" href="/admin/website-settings"><span class="icon-square"><i class="bi bi-globe"></i></span> Website Sync</a></li><li class="nav-item"><a class="nav-link <%= title === 'Database Settings' ? 'active' : '' %>" href="/admin/database-settings"><i class="bi bi-database me-2"></i> <span>Database</span></a></li><li class="nav-item d-md-none"><a class="nav-link text-danger" href="/auth/logout"><span class="icon-square"><i class="bi bi-box-arrow-right"></i></span> Logout</a></li></ul></div></div><div class="content-wrapper"><main class="content"><div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom"><h1 class="h2"><%= title %></h1> <% if (title === 'Admin Dashboard') { %> <div class="btn-toolbar mb-2 mb-md-0"><button type="button" class="btn btn-outline-primary btn-sm" id="captchaTestBtn"><i class="bi bi-shield-check me-1"></i>CAPTCHA Test</button></div> <% } %> </div> <%- body %> </main></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script><script src="https://cdn.jsdelivr.net/npm/chart.js@4.0.0/dist/chart.umd.min.js"></script><script>document.addEventListener("DOMContentLoaded",function(){const n=document.getElementById("sidebarToggle"),e=document.getElementById("sidebarMenu");n&&n.addEventListener("click",function(){e.classList.toggle("show")}),document.addEventListener("click",function(t){const s=e.contains(t.target),i=n.contains(t.target);!s&&!i&&e.classList.contains("show")&&window.innerWidth<768&&e.classList.remove("show")}),window.addEventListener("resize",function(){window.innerWidth>=768&&e.classList.remove("show")})})</script><script>window.runCaptchaTest=async function(){console.log("🔍 runCaptchaTest() called");const e=document.getElementById("captchaTestBtn");if(console.log("🔍 Button found:",e),!e)return void console.error("❌ CAPTCHA Test button not found!");const t=e.innerHTML;try{e.disabled=!0,e.innerHTML='<i class="bi bi-hourglass-split me-1"></i>Testing...',window.showAlert("info","Starting CAPTCHA test with UID 2312730961. Browser will open automatically.");const t=await fetch("/admin/captcha-test",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({uid:"2312730961"})}),n=await t.json();n.success?window.showAlert("success",n.message+" Session data has been saved to Chrome profile."):window.showAlert("danger","CAPTCHA test failed: "+n.message)}catch(e){console.error("CAPTCHA test error:",e),window.showAlert("danger","CAPTCHA test error: "+e.message)}finally{e.disabled=!1,e.innerHTML=t}},window.showAlert=function(e,t){console.log("🔍 showAlert called:",e,t);document.querySelectorAll(".alert").forEach(e=>e.remove());const n=document.createElement("div");n.className=`alert alert-${e} alert-dismissible fade show`,n.role="alert",n.innerHTML=`\n        ${t}\n        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>\n      `;const o=document.querySelector(".content");o?o.insertBefore(n,o.firstChild):console.error("❌ Main content area not found for alert"),setTimeout(()=>{n&&n.parentNode&&n.remove()},1e4)},document.addEventListener("DOMContentLoaded",function(){const e=document.getElementById("captchaTestBtn");e?(console.log("🔍 CAPTCHA button found, adding event listener"),e.addEventListener("click",function(){console.log("🔍 CAPTCHA button clicked via event listener"),window.runCaptchaTest()})):console.log("🔍 CAPTCHA button not found on this page")}),window.testButton=function(){console.log("🔍 Test button clicked!"),window.showAlert("info","Button test successful!")},window.restartSystem=async function(){console.log("🔄 restartSystem() called");const e=document.getElementById("restartBtn"),t=document.getElementById("confirmRestartBtn");if(!e||!t)return void console.error("❌ Restart button not found!");const n=e.innerHTML,o=t.innerHTML;try{e.disabled=!0,t.disabled=!0,e.innerHTML='<i class="bi bi-hourglass-split"></i><span class="d-none d-sm-inline ms-1">Restarting...</span>',t.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Restarting...',window.showAlert("warning","System restart initiated. Please wait...");const s=await fetch("/admin/restart",{method:"POST",headers:{"Content-Type":"application/json"}}),r=await s.json();if(r.success){window.showAlert("success",r.message);const e=bootstrap.Modal.getInstance(document.getElementById("restartModal"));e&&e.hide(),setTimeout(()=>{window.location.href="/auth/login"},3e3)}else window.showAlert("danger","System restart failed: "+r.message),e.disabled=!1,t.disabled=!1,e.innerHTML=n,t.innerHTML=o}catch(s){console.error("System restart error:",s),window.showAlert("danger","System restart error: "+s.message),e.disabled=!1,t.disabled=!1,e.innerHTML=n,t.innerHTML=o}},document.addEventListener("DOMContentLoaded",function(){const e=document.getElementById("restartBtn"),t=document.getElementById("confirmRestartBtn"),n=document.getElementById("restartModal");e&&n?(e.addEventListener("click",function(){console.log("🔄 Restart button clicked - showing modal");new bootstrap.Modal(n).show()}),console.log("✅ Restart button event listener added")):console.error("❌ Restart button or modal not found"),t?(t.addEventListener("click",function(){console.log("🔄 Restart confirmed"),window.restartSystem()}),console.log("✅ Confirm restart button event listener added")):console.error("❌ Confirm restart button not found")})</script> <%- script %> </body></html>