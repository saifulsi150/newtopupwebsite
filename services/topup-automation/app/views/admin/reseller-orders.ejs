<% if (success) { %> <div class="alert alert-success alert-dismissible fade show" role="alert"> <%= success %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <% if (error) { %> <div class="alert alert-danger alert-dismissible fade show" role="alert"> <%= error %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <% if (resellers.length === 0) { %> <div class="card"><div class="card-body text-center py-5"><i class="bi bi-shop fs-1 text-muted mb-3"></i><h5 class="mb-3">No Resellers Configured</h5><p class="text-muted">Add reseller websites in the Website Sync settings page.</p><a href="/admin/website-settings" class="btn btn-primary"><i class="bi bi-gear me-2"></i>Go to Website Settings</a></div></div> <% } else { %> <ul class="nav nav-tabs mb-4" id="resellerTabs" role="tablist"> <% 
      const activeTabIndex = typeof activeTab !== 'undefined' ? activeTab : 0;
    %> <% resellers.forEach((reseller, index) => { %> <li class="nav-item" role="presentation"><button class="nav-link <%= index === activeTabIndex ? 'active' : '' %>" id="tab-<%= index %>" data-bs-toggle="tab" data-bs-target="#panel-<%= index %>" type="button" role="tab"> <%= reseller.name %> </button></li> <% }); %> </ul><div class="tab-content" id="resellerTabContent"> <% resellers.forEach((reseller, index) => { %> <div class="tab-pane fade <%= index === activeTabIndex ? 'show active' : '' %>" id="panel-<%= index %>" role="tabpanel"><div class="card mb-4"><div class="card-header"><h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Statistics - <%= reseller.name %> </h5></div><div class="card-body"><div class="row g-2"><div class="col-6"><div class="text-center p-3 bg-light rounded"><h4 class="mb-0"><%= reseller.stats.total || 0 %></h4><small class="text-muted">Total Orders</small></div></div><div class="col-6"><div class="text-center p-3 bg-light rounded"><h4 class="mb-0 text-success"><%= reseller.stats.completed || 0 %></h4><small class="text-muted">Completed</small></div></div><div class="col-6"><div class="text-center p-3 bg-light rounded"><h4 class="mb-0 text-primary"><%= reseller.stats.processing || 0 %></h4><small class="text-muted">Processing</small></div></div><div class="col-6"><div class="text-center p-3 bg-light rounded"><h4 class="mb-0 text-danger"><%= reseller.stats.failed || 0 %></h4><small class="text-muted">Failed</small></div></div></div><hr><div class="row mt-3"><div class="col-md-6"><h6>UC Usage Breakdown</h6> <% if (reseller.ucUsage && reseller.ucUsage.length > 0) { %> <table class="table table-sm"><thead><tr><th>UC Value</th><th>Usage Count</th></tr></thead><tbody> <% reseller.ucUsage.forEach(uc => { %> <tr><td><%= uc.uc_value %> UC</td><td><%= uc.usage_count %></td></tr> <% }); %> </tbody></table> <% } else { %> <p class="text-muted">No UC usage data available</p> <% } %> </div><div class="col-md-6"><h6>Total Value</h6><div class="p-3 bg-success bg-opacity-10 rounded"><h3 class="text-success mb-0"><%= reseller.totalUCValue || 0 %> TK</h3><small class="text-muted">Total UC Value</small></div></div></div><hr><div class="d-flex justify-content-end"><button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteResellerOrdersModal<%= index %>"><i class="bi bi-trash me-2"></i>Delete All <%= reseller.name %> Orders</button></div></div></div><div class="card"><div class="card-header"><h5 class="mb-0">Orders - <%= reseller.name %></h5></div><div class="card-body"><div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>ID</th><th>OrderID</th><th>UID</th><th><span class="d-md-none">Diamond</span><span class="d-none d-md-inline">Diamond Quantity</span></th><th>Status</th><th>Created</th><th class="d-none d-md-table-cell">Updated At</th><th>Actions</th></tr></thead><tbody> <% if (reseller.orders.length === 0) { %> <tr><td colspan="8" class="text-center">No orders found for this reseller</td></tr> <% } else { %> <% reseller.orders.forEach(order => { %> <tr><td><%= order.id %></td><td><%= order.order_id %></td><td><%= order.uid %></td><td><%= formatDiamondQuantity(order.diamond_quantity) %></td><td> <% if (order.status === 'pending') { %> <span class="badge bg-warning text-dark">Pending</span> <% } else if (order.status === 'processing') { %> <span class="badge bg-info">Processing</span> <% } else if (order.status === 'completed') { %> <span class="badge bg-success">Completed</span> <% } else if (order.status === 'failed') { %> <span class="badge bg-danger">Failed</span> <% } %> </td><td><%= formatDate(order.created_at) %></td><td class="d-none d-md-table-cell"><%= formatDate(order.updated_at) %></td><td><a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> View</a></td></tr> <% }); %> <% } %> </tbody></table></div></div></div></div> <% }); %> </div> <% resellers.forEach((reseller, index) => { %> <div class="modal fade" id="deleteResellerOrdersModal<%= index %>" tabindex="-1" aria-labelledby="deleteResellerOrdersModalLabel<%= index %>" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header bg-danger text-white"><h5 class="modal-title" id="deleteResellerOrdersModalLabel<%= index %>"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete All Orders</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><p>Are you sure you want to delete <strong>all orders</strong> for <strong><%= reseller.name %></strong>?</p><p class="text-danger"><strong>This action cannot be undone!</strong></p><p class="mb-0">Total orders to be deleted: <strong><%= reseller.stats.total || 0 %></strong></p></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><form action="/admin/reseller-orders/delete" method="POST" style="display:inline"><input type="hidden" name="apiKey" value="<%= reseller.api_key %>"> <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Delete All Orders</button></form></div></div></div></div> <% }); %> <% } %>