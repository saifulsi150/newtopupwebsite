<style>@media (max-width:767.98px){.table-responsive{font-size:.875rem}.table td,.table th{padding:.5rem .25rem;vertical-align:middle}.table th{font-size:.75rem;font-weight:600}.card-body{padding:.75rem}}.stat-card{transition:transform .2s}.stat-card:hover{transform:translateY(-2px)}.btn-group .btn{min-width:100px}@media (max-width:575.98px){.btn-group{display:flex;flex-wrap:wrap;gap:.25rem}.btn-group .btn{flex:1 1 auto;min-width:calc(50% - .125rem)}}</style> <% if (success) { %> <div class="alert alert-success alert-dismissible fade show" role="alert"> <%= success %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <% if (error) { %> <div class="alert alert-danger alert-dismissible fade show" role="alert"> <%= error %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <div class="card mb-3 mb-md-4"><div class="card-body p-2 p-md-3"><div class="row g-2 g-md-3 align-items-center"><div class="col-12 col-md-6"><label class="form-label mb-2 mb-md-0 fw-bold">Time Range:</label><div class="btn-group" role="group" aria-label="Time range selector"><a href="/admin/statistics?range=7days" class="btn <%= timeRange === '7days' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm">7 Days</a> <a href="/admin/statistics?range=30days" class="btn <%= timeRange === '30days' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm">30 Days</a> <a href="/admin/statistics?range=previousMonth" class="btn <%= timeRange === 'previousMonth' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm">Previous Month</a> <a href="/admin/statistics?range=3months" class="btn <%= timeRange === '3months' ? 'btn-primary' : 'btn-outline-primary' %> btn-sm">3 Months</a></div></div><div class="col-12 col-md-6 text-md-end"><small class="text-muted"><i class="bi bi-calendar-range me-1"></i> <% 
            function formatDateDDMYYYY(date) {
              const day = date.getDate();
              const month = date.getMonth() + 1;
              const year = date.getFullYear();
              return `${day}/${month}/${year}`;
            }
            let displayStartDate, displayEndDate;
            if (typeof startDateObj !== 'undefined') {
              displayStartDate = formatDateDDMYYYY(startDateObj);
              displayEndDate = formatDateDDMYYYY(endDateObj);
            } else {
              displayStartDate = formatDateDDMYYYY(new Date(startDate));
              displayEndDate = formatDateDDMYYYY(new Date(endDate));
            }
          %> <%= displayStartDate %> - <%= displayEndDate %> </small></div></div></div></div><div class="row mb-4 g-2"><div class="col-6"><div class="card stat-card h-100"><div class="card-body"><h6 class="card-subtitle mb-2 text-muted">Total Orders</h6><h3 class="card-title mb-0"> <%= variantStats.reduce((sum, stat) => sum + (stat.order_count || 0), 0) %> </h3><small class="text-muted">Orders processed</small></div></div></div><div class="col-6"><div class="card stat-card h-100"><div class="card-body"><h6 class="card-subtitle mb-2 text-muted">Total Code Usage</h6><h3 class="card-title mb-0"> <%= variantStats.reduce((sum, stat) => sum + (stat.usage_count || 0), 0) %> </h3><small class="text-muted">Codes used in this period</small></div></div></div></div><div class="card mb-4"><div class="card-header"><h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Most Used Code Variants</h5></div><div class="card-body p-2 p-md-3"> <% if (variantStats.length === 0) { %> <div class="alert alert-info mb-0"><i class="bi bi-info-circle me-2"></i> No code usage statistics found for the selected time range.</div> <% } else { %> <div class="table-responsive"><table class="table table-striped table-hover table-sm mb-0"><thead><tr><th class="ps-2 pe-1" style="width:60px">Rank</th><th class="px-2">UC Value</th><th class="px-2">Usage Count</th><th class="px-2">Order Count</th><th class="px-2">Usage Percentage</th></tr></thead><tbody> <% 
              const totalUsage = variantStats.reduce((sum, stat) => sum + (stat.usage_count || 0), 0);
              variantStats.forEach((stat, index) => {
                const usagePercentage = totalUsage > 0 ? ((stat.usage_count / totalUsage) * 100).toFixed(2) : 0;
            %> <tr><td class="ps-2 pe-1"><span class="badge bg-primary"><%= index + 1 %></span></td><td class="px-2"><strong><%= stat.uc_value %> UC</strong></td><td class="px-2"><strong class="text-primary"><%= stat.usage_count || 0 %></strong></td><td class="px-2"><span class="text-muted"><%= stat.order_count || 0 %></span></td><td class="px-2"><div class="d-flex align-items-center"><div class="progress flex-grow-1 me-2" style="height:20px"><div class="progress-bar" role="progressbar" style="width: <%= usagePercentage %>%" aria-valuenow="<%= usagePercentage %>" aria-valuemin="0" aria-valuemax="100"> <%= usagePercentage %>%</div></div></div></td></tr> <% }); %> </tbody></table></div> <% } %> </div></div>