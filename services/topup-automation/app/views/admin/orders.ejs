<% if (success) { %> <div class="alert alert-success alert-dismissible fade show" role="alert"> <%= success %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <% if (error) { %> <div class="alert alert-danger alert-dismissible fade show" role="alert"> <%= error %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <div class="card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h5 class="mb-0">Order Management</h5></div><form action="/admin/orders" class="row g-3"><div class="col-md-6"><div class="input-group"><input class="form-control" placeholder="Search by Order ID or UID..." name="search" value="<%= search %>"> <button class="btn btn-primary" type="submit">Search</button></div></div><div class="col-md-4"><select class="form-select" name="filter" id="filterSelect"><option value="all" <%= filter === 'all' ? 'selected' : '' %>>All Orders</option><option value="pending" <%= filter === 'pending' ? 'selected' : '' %>>Pending</option><option value="processing" <%= filter === 'processing' ? 'selected' : '' %>>Processing</option><option value="completed" <%= filter === 'completed' ? 'selected' : '' %>>Completed</option><option value="failed" <%= filter === 'failed' ? 'selected' : '' %>>Failed</option><option value="cancelled" <%= filter === 'cancelled' ? 'selected' : '' %>>Cancelled</option></select></div><div class="col-md-2"><a href="/admin/orders" class="btn btn-secondary w-100">Reset</a></div></form></div></div><div class="card mb-4"><div class="card-header"><h5 class="mb-0">Orders List</h5></div><div class="card-body"><div class="d-flex justify-content-end mb-2"><form action="/admin/orders/start-process" method="POST" style="display:inline" class="me-2"><button type="submit" class="btn btn-start-process">Start Process</button></form><button type="button" class="btn btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#retryAllOrdersModal">Retry all failed orders</button> <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#clearAllOrdersModal">Clear All Orders</button></div><div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>ID</th><th>OrderID</th><th>UID</th><th><span class="d-md-none">Diamond</span><span class="d-none d-md-inline">Diamond Quantity</span></th><th>Status</th><th>Created</th><th class="d-none d-md-table-cell">Updated At</th><th>Actions</th></tr></thead><tbody> <% if (orders.length === 0) { %> <tr><td colspan="8" class="text-center">No orders found</td></tr> <% } else { %> <% orders.forEach(order => { %> <tr><td><%= order.id %></td><td><div class="d-flex align-items-center gap-2 flex-wrap"><span><%= order.order_id %></span> <% if (order.source_site_name || order.source_site_url) { %> <span class="badge bg-info"><i class="bi bi-globe"></i> <%= order.source_site_name || "Website" %></span> <% } %> <% if (order.source_site_url) { %> <a href="<%= order.source_site_url %>" target="_blank" class="badge bg-secondary text-decoration-none"><i class="bi bi-link-45deg"></i> Source Link</a> <% } %> </div></td><td><%= order.uid %></td><td><%= formatDiamondQuantity(order.diamond_quantity) %></td><td> <% if (order.status === 'pending') { %> <span class="badge bg-warning text-dark">Pending</span> <% } else if (order.status === 'processing') { %> <span class="badge bg-info">Processing</span> <% } else if (order.status === 'completed') { %> <span class="badge bg-success">Completed</span> <% } else if (order.status === 'cancelled') { %> <span class="badge bg-danger">Cancelled</span> <% } else if (order.status === 'failed') { %> <span class="badge bg-danger">Failed</span> <% } %> </td><td><%= formatDate(order.created_at) %></td><td class="d-none d-md-table-cell"><%= formatDate(order.updated_at) %></td><td><a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> View</a></td></tr> <% }); %> <% } %> </tbody></table></div></div> <% if (pagination.total > 1) { %> <div class="card-footer"><nav><ul class="pagination justify-content-center m-0"> <% if (pagination.current > 1) { %> <li class="page-item"><a class="page-link" href="/admin/orders?page=<%= pagination.current - 1 %>&search=<%= search %>&filter=<%= filter %>">Previous</a></li> <% } else { %> <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li> <% } %> <% for(let i = 1; i <= pagination.total; i++) { %> <% if (i === pagination.current) { %> <li class="page-item active"><a class="page-link" href="#"><%= i %></a></li> <% } else if (
              i === 1 || 
              i === pagination.total || 
              (i >= pagination.current - 2 && i <= pagination.current + 2)
            ) { %> <li class="page-item"><a class="page-link" href="/admin/orders?page=<%= i %>&search=<%= search %>&filter=<%= filter %>"><%= i %></a></li> <% } else if (
              i === pagination.current - 3 || 
              i === pagination.current + 3
            ) { %> <li class="page-item disabled"><a class="page-link" href="#">...</a></li> <% } %> <% } %> <% if (pagination.current < pagination.total) { %> <li class="page-item"><a class="page-link" href="/admin/orders?page=<%= pagination.current + 1 %>&search=<%= search %>&filter=<%= filter %>">Next</a></li> <% } else { %> <li class="page-item disabled"><a class="page-link" href="#">Next</a></li> <% } %> </ul></nav></div> <% } %> </div><div class="row"><div class="col-md-6"><div class="card mb-4"><div class="card-header"><h5 class="mb-0">Order Statistics</h5></div><div class="card-body"><div class="row"><div class="col-sm-6 mb-3"><div class="card bg-light"><div class="card-body text-center"><h5 class="card-title">Total Orders</h5><h2 class="mb-0"><%= orderStats.total || 0 %></h2></div></div></div><div class="col-sm-6 mb-3"><div class="card bg-success text-white"><div class="card-body text-center"><h5 class="card-title">Completed</h5><h2 class="mb-0"><%= orderStats.completed || 0 %></h2></div></div></div><div class="col-sm-6 mb-3"><div class="card bg-warning text-dark"><div class="card-body text-center"><h5 class="card-title">Pending</h5><h2 class="mb-0"><%= orderStats.pending || 0 %></h2></div></div></div><div class="col-sm-6 mb-3"><div class="card bg-danger text-white"><div class="card-body text-center"><h5 class="card-title">Failed</h5><h2 class="mb-0"><%= orderStats.failed || 0 %></h2></div></div></div></div></div></div></div><div class="col-md-6"><div class="card mb-4"><div class="card-header"><h5 class="mb-0">Processing Orders</h5></div><div class="card-body"> <% 
          const processingOrders = orders.filter(order => order.status === 'processing');
          if (processingOrders.length === 0) { 
        %> <div class="alert alert-info mb-0"><i class="bi bi-info-circle me-2"></i> No orders currently in processing state</div> <% } else { %> <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Order ID</th><th>UID</th><th>Diamond Quantity</th><th>Status</th><th>Started At</th><th>Action</th></tr></thead><tbody> <% processingOrders.forEach(order => { %> <tr><td><%= order.order_id %></td><td><%= order.uid %></td><td><%= formatDiamondQuantity(order.diamond_quantity) %></td><td> <% if (order.status === 'pending') { %> <span class="badge bg-warning text-dark">Pending</span> <% } else if (order.status === 'processing') { %> <span class="badge bg-info">Processing</span> <% } else if (order.status === 'completed') { %> <span class="badge bg-success">Completed</span> <% } else if (order.status === 'cancelled') { %> <span class="badge bg-danger">Cancelled</span> <% } else if (order.status === 'failed') { %> <span class="badge bg-danger">Failed</span> <% } %> </td><td><%= formatDate(order.updated_at) %></td><td><a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> View</a></td></tr> <% }); %> </tbody></table></div> <% } %> </div></div></div></div><div class="modal fade" id="retryAllOrdersModal" tabindex="-1" aria-labelledby="retryAllOrdersModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="retryAllOrdersModalLabel">Confirm Retry All Orders</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">Are you sure you want to retry ALL failed orders? This will queue them for processing.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><form action="/admin/orders/retry-all" method="POST" style="display:inline"><button type="submit" class="btn btn-primary">Yes, Retry All Orders</button></form></div></div></div></div><div class="modal fade" id="clearAllOrdersModal" tabindex="-1" aria-labelledby="clearAllOrdersModalLabel" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="clearAllOrdersModalLabel">Confirm Clear All Orders</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">Are you sure you want to delete ALL orders? This cannot be undone.</div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><form action="/admin/orders/clear-all" method="POST" style="display:inline"><button type="submit" class="btn btn-danger">Yes, Delete All Orders</button></form></div></div></div></div><style>.btn-start-process{color:#ffc107;background-color:transparent;border-color:#ffc107}.btn-start-process:hover{color:#fff;background-color:#ffc107;border-color:#ffc107}.btn-start-process:focus{color:#fff;background-color:#ffc107;border-color:#ffc107;box-shadow:0 0 0 .25rem rgba(255,193,7,.5)}</style><script>document.addEventListener("DOMContentLoaded",function(){const e=document.getElementById("filterSelect");e&&e.addEventListener("change",function(){this.form.submit()})})</script>
