<div class="row"><div class="col-md-12"><div class="card mb-4"><div class="card-header"><h5 class="card-title mb-0">Database Settings</h5></div><div class="card-body"> <% if (success) { %> <div class="alert alert-success alert-dismissible fade show" role="alert"><i class="bi bi-check-circle-fill me-2"></i><%= success %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <% if (error) { %> <div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <div class="alert alert-info mb-4"><h5><i class="bi bi-info-circle-fill me-2"></i>Important Information</h5><p>Database settings are critical for the proper functioning of the application. Changing these settings will update your database connection.</p><p>After saving, the application will automatically create necessary tables in your database if they don't already exist.</p><p><strong>Note:</strong> You will need to restart the application for these changes to take full effect.</p></div><form method="post" action="/admin/database-settings"><div class="row"><div class="col-md-6"><div class="mb-3"><label for="host" class="form-label">Database Host</label> <input class="form-control" id="host" name="host" value="<%= dbConfig.host %>" required><div class="form-text">Usually "localhost" for local databases</div></div><div class="mb-3"><label for="port" class="form-label">Database Port</label> <input class="form-control" id="port" name="port" value="<%= dbConfig.port %>"><div class="form-text">Default MySQL port is 3306</div></div><div class="mb-3"><label for="database" class="form-label">Database Name</label> <input class="form-control" id="database" name="database" value="<%= dbConfig.database %>" required><div class="form-text">The name of your MySQL database</div></div></div><div class="col-md-6"><div class="mb-3"><label for="user" class="form-label">Database User</label> <input class="form-control" id="user" name="user" value="<%= dbConfig.user %>" required><div class="form-text">Usually "root" for local development</div></div><div class="mb-3"><label for="password" class="form-label">Database Password</label> <input type="password" class="form-control" id="password" name="password" value="<%= dbConfig.password %>"><div class="form-text">Leave empty if no password is required</div></div><div class="form-check form-switch mt-4"><input class="form-check-input" type="checkbox" id="initialize_db" name="initialize_db" value="1" checked="checked"> <label class="form-check-label" for="initialize_db">Initialize database tables automatically</label></div></div></div><div class="mt-4 d-flex justify-content-between"><button type="button" class="btn btn-info" id="test-connection"><i class="bi bi-plug-fill me-2"></i>Test Connection</button><div><a href="/admin/settings" class="btn btn-secondary me-2"><i class="bi bi-arrow-left me-2"></i>Back to Settings </a><button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i>Save Database Settings</button></div></div><div id="test-result" class="mt-3" style="display:none"></div></form></div></div></div></div><script>document.addEventListener("DOMContentLoaded",function(){const e=document.getElementById("test-connection"),t=document.getElementById("test-result");e.addEventListener("click",function(){const n=document.getElementById("host").value,s=document.getElementById("user").value,a=document.getElementById("password").value,d=document.getElementById("database").value,l=document.getElementById("port").value;if(!n||!s||!d)return t.className="alert alert-danger mt-3",t.textContent="Host, user, and database name are required",void(t.style.display="block");e.disabled=!0,e.innerHTML='<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Testing...',t.style.display="none",fetch("/admin/database-settings/test",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({host:n,user:s,password:a,database:d,port:l})}).then(e=>e.json()).then(e=>{t.className=e.success?"alert alert-success mt-3":"alert alert-danger mt-3",t.textContent=e.message,t.style.display="block"}).catch(e=>{t.className="alert alert-danger mt-3",t.textContent="Error testing connection: "+e.message,t.style.display="block"}).finally(()=>{e.disabled=!1,e.innerHTML='<i class="bi bi-plug-fill me-2"></i>Test Connection'})})})</script>