<div class="row"><div class="col-md-12"><div class="card mb-4"><div class="card-header"><h5 class="card-title mb-0">System Settings</h5></div><div class="card-body"> <% if (success) { %> <div id="settingsSuccessAlert" class="alert alert-success alert-dismissible fade show" role="alert"><i class="bi bi-check-circle-fill me-2"></i><%= success %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <% if (error) { %> <div id="settingsErrorAlert" class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %> <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> <% } %> <div id="cookieResultAlert" style="display:none"></div><form action="/admin/settings" method="POST"><div class="row mb-4"><div class="col-md-6"><h6 class="fw-bold mb-3">Admin Credentials</h6><div class="mb-3"><label for="admin_username" class="form-label">Admin Username</label> <input class="form-control" id="admin_username" name="admin_username" value="<%= adminUsername || '' %>" required> <small class="form-text text-muted"><i class="bi bi-info-circle me-1"></i> Change the admin panel username</small></div><div class="mb-3"><label for="admin_password" class="form-label">Admin Password</label> <input type="password" class="form-control" id="admin_password" name="admin_password" placeholder="Leave blank to keep current password"> <small class="form-text text-muted"><i class="bi bi-info-circle me-1"></i> Leave blank if you don't want to change the password</small></div><div class="mb-3"><label for="admin_password_confirm" class="form-label">Confirm Password</label> <input type="password" class="form-control" id="admin_password_confirm" name="admin_password_confirm" placeholder="Confirm new password"></div></div><div class="col-md-6"><h6 class="fw-bold mb-3">UC Prices (Taka)</h6><p class="text-muted small mb-3">Configure the price for each UC value used in dashboard and reseller order calculations.</p> <% if (supportedUCValues && supportedUCValues.length > 0) { %> <div class="row g-2"> <% supportedUCValues.forEach(ucValue => { %> <div class="col-6"><label for="uc_price_<%= ucValue %>" class="form-label small mb-1"> <%= ucValue %> UC</label><div class="input-group input-group-sm"><input type="number" class="form-control" id="uc_price_<%= ucValue %>" name="uc_prices[<%= ucValue %>]" value="<%= ucPrices && ucPrices[ucValue] ? ucPrices[ucValue] : 0 %>" min="0" step="0.01" required> <span class="input-group-text">TK</span></div></div> <% }); %> </div> <% } else { %> <p class="text-muted">No UC values configured.</p> <% } %> </div></div><div class="d-flex flex-column flex-sm-row gap-2 vnbazer-submit mt-3"><button type="submit" class="btn btn-primary d-flex align-items-center justify-content-center w-auto"><i class="bi bi-save me-2"></i>Save Settings</button> <button id="loadCookieBtn" type="button" class="btn d-flex align-items-center justify-content-center w-auto" style="background-color:#198754;color:#fff"><i class="bi bi-upload me-2"></i>Load Cookie</button></div></form></div></div></div></div><script>document.addEventListener("DOMContentLoaded",function(){const e=document.getElementById("loadCookieBtn"),t=document.getElementById("cookieResultAlert");e&&e.addEventListener("click",function(){const s=e.innerHTML;e.disabled=!0,e.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Loading...',fetch("/admin/settings/load-cookie",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"}}).then(e=>e.json()).then(e=>{t.style.display="block",t.className="alert "+(e.success?"alert-success":"alert-danger")+" alert-dismissible fade show",t.innerHTML=`\n          <i class="bi ${e.success?"bi-check-circle-fill":"bi-exclamation-triangle-fill"} me-2"></i>${e.message}\n          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>\n        `,setTimeout(()=>{t.style.display="none"},4e3)}).catch(e=>{t.style.display="block",t.className="alert alert-danger alert-dismissible fade show",t.innerHTML=`\n          <i class="bi bi-exclamation-triangle-fill me-2"></i>Error: ${e.message}\n          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>\n        `,setTimeout(()=>{t.style.display="none"},5e3)}).finally(()=>{e.disabled=!1,e.innerHTML=s})});const s=document.getElementById("admin_password"),n=document.getElementById("admin_password_confirm"),a=document.querySelector("form");a&&a.addEventListener("submit",function(e){const t=s.value,a=n.value;return t&&t!==a?(e.preventDefault(),alert("Passwords do not match. Please try again."),n.focus(),!1):t&&t.length<6?(e.preventDefault(),alert("Password must be at least 6 characters long."),s.focus(),!1):void 0})})</script>