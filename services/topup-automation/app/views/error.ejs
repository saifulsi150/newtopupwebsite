<div class="row"><div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body py-4"><div class="row align-items-center mb-4"><div class="col-auto"><i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:3rem"></i></div><div class="col"><p class="lead mb-0 text-muted"><%= message || 'Something went wrong' %></p></div></div> <% if (error && (typeof error === 'object' ? (error.stack || Object.keys(error).length > 0) : error)) { %> <div class="alert alert-danger text-start mt-4 mb-4"><h5 class="alert-heading mb-3">Error Details:</h5><pre class="mb-0" style="white-space:pre-wrap;word-wrap:break-word;font-size:.85rem;max-height:500px;overflow-y:auto"><%= typeof error === 'object' ? (error.stack || JSON.stringify(error, null, 2)) : error %></pre></div> <% } %> <div class="mt-4 d-flex justify-content-between"><a href="/admin/dashboard" class="btn btn-primary"><i class="bi bi-house me-1"></i>Go Home </a><a href="javascript:history.back()" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Go Back</a></div></div></div></div></div>